+/*
+ * apollo: the firmware's memory on round boundaries, as Android's cnss2 hands it out on the Mi 10T (its log: HOST_DDR at
+ * 0xa1000000, the type 4 chunk at 0xa1600000, M3 at 0xa1880000) -- the lx pool otherwise aligns to 64 bytes only.
+ * More is taken than asked for and the start moved up to the boundary (the pool's rings are never given back).
+ */
+static void *apollo_dma_alloc_aligned(struct device *dev, size_t size, dma_addr_t *paddr, size_t align)
+{
+	dma_addr_t raw;
+	void *vaddr = dma_alloc_coherent(dev, size + align, &raw, GFP_KERNEL | __GFP_NOWARN);
+	size_t skip;
+
+	if (!vaddr)
+		return NULL;
+	skip = (size_t)((align - (raw & (align - 1))) & (align - 1));
+	*paddr = raw + skip;
+	return (u8 *)vaddr + skip;
+}
