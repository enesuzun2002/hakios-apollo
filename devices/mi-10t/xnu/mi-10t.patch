+/*
+ * iOS sets the brightness on the framebuffer's registry entry: IOMFBBrightnessLevel, nits in 16.16 fixed point
+ * (CoreBrightness: IORegistryEntrySetCFProperty with a SInt32; it does so only once it has found a backlight service,
+ * which this kernel does not publish yet: the slider reaches the backlight through backboardd, userland/src/inject.c). Taken for the Mi 10T's backlight (bsd/dev/hakios.apollo_backlight.c); anything else is refused
+ * as before, and the first few keys that are said so (with the program that sent them).
+ */
+IOReturn
+IOMobileFramebuffer::setProperties(OSObject * properties)
+{
+	OSDictionary * dict = OSDynamicCast(OSDictionary, properties);
+	OSCollectionIterator * keys;
+	OSObject * next;
+	IOReturn result = kIOReturnUnsupported;
+	static unsigned said;
+
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	keys = OSCollectionIterator::withCollection(dict);
+	if (keys == NULL) {
+		return kIOReturnNoMemory;
+	}
+	while ((next = keys->getNextObject()) != NULL) {
+		const OSSymbol * key = OSDynamicCast(OSSymbol, next);
+		OSNumber * number = key != NULL ? OSDynamicCast(OSNumber, dict->getObject(key)) : NULL;
+
+		if (key != NULL && number != NULL && key->isEqualTo("IOMFBBrightnessLevel")) {
+			/* CoreBrightness's value is nits in 16.16 fixed point: taken as a share of 500 nits */
+			apollo_backlight_set((uint32_t) number->unsigned32BitValue() / 500);
+			result = kIOReturnSuccess;
+		} else if (said++ < 8) {
+			char who[32] = "?";
+
+			proc_selfname(who, sizeof(who));
+			IOLog("MiniIOMobileFramebuffer: %s sets \"%s\" on the display: not taken\n", who,
+			    key != NULL ? key->getCStringNoCopy() : "?");
+		}
+	}
+	keys->release();
+	return result;
+}
